{
    "name": "ospl-textmate",
    "displayName": "OSPL grammars",
    "description": "Provide TextMate grammars and LSP for OSPL",
    "version": "0.0.1",
    "publisher": "ospl",
    "scripts": {
        "compile": "tsc -p ./"
    },
    "main": "./out/extension.js",
    "engines": {
        "vscode": "^1.109.2"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "ospl",
                "aliases": [
                    "OSPL (Oscar's Stupid Programming Language)",
                    "ospl"
                ],
                "extensions": [
                    ".ospl"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ospl",
                "scopeName": "source.ospl",
                "path": "./syntaxes/ospl.tmLanguage.json"
            }
        ],
        "themes": [
            {
                "label": "OSPL",
                "uiTheme": "vs-dark",
                "path": "./themes/ospl-color-theme.json"
            }
        ],
        "commands": [
            {
                "command": "ospl.stopLsp",
                "title": "ospl: stop lsp"
            },
            {
                "command": "ospl.startLsp",
                "title": "ospl: start lsp"
            }
        ]
    },
    "dependencies": {
        "vscode-languageclient": "^10.1.0",
        "@types/node": "^22",
        "@types/vscode": "^1.100.0"
    }
}
