{   # program should loop forever if retscopes are functional.
    # NOTE: can only get the FIRST one in both the typelist (scope{x: int}) AND 
    #       the declaration list (def x = 21)
    def Point2 = fn() -> scope{x: int; y: int} {
        def x = 21;
        def y = 12;
        return scope;
    };

    def p = Point2();
    if p.x == 21 {
        if p.y == 12 {
            loop {};
        };
    };
}